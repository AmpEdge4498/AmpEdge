# ===========================================
# AmpEdge Backend - Environment Variables
# ===========================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env

NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/ampedge_db

# JWT settings for role-based session tokens
JWT_SECRET=YOUR_JWT_SECRET_HERE
JWT_EXPIRE=30d

# Firebase (path to your service account JSON key)
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# Razorpay Keys (use test keys for development)
RAZORPAY_KEY_ID=your_razorpay_test_key_id
RAZORPAY_KEY_SECRET=your_razorpay_test_key_secret
