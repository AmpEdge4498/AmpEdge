NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/ampedge_db

# JWT settings for our own role-based session tokens
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRE=30d

# Firebase Admin SDK path
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# Request Signing Secret for security middleware
REQUEST_SIGNING_SECRET=your_request_signing_secret_here

# Razorpay Test Keys
RAZORPAY_KEY_ID=your_razorpay_test_key_id
RAZORPAY_KEY_SECRET=your_razorpay_test_key_secret

# Google Maps Geocoding API Key
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Admin Registration Key
ADMIN_REGISTRATION_KEY=your_admin_registration_secret_here
DEFAULT_ADMIN_EMAIL=admin@yourdomain.com
DEFAULT_ADMIN_PASSWORD=your_secure_password
DEFAULT_ADMIN_PHONE=+919999999999

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174,https://yourproductiondomain.com

# Logging
LOG_LEVEL=info
