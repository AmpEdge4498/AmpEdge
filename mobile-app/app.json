{
  "expo": {
    "name": "ampedgesolutions-apk",
    "slug": "ampedgesolutions-apk-yc1n0tol7ddm657as92vz",
    "scheme": "ampedge",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#4169E1"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ampedge.app",
      "googleServicesFile": "./GoogleService-Info.plist",
      "associatedDomains": [
        "applinks:ampedge.in",
        "applinks:rittickd23-alt.github.io"
      ]
    },
    "android": {
      "package": "com.ampedge.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#4169E1",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "googleServicesFile": "./google-services.json",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "ampedge.in",
              "pathPrefix": "/"
            },
            {
              "scheme": "https",
              "host": "rittickd23-alt.github.io",
              "pathPrefix": "/AmpEdge-web"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow AmpEdge to use Face ID for secure login."
        }
      ],
      "expo-secure-store"
    ],
    "extra": {
      "eas": {
        "projectId": "db136098-a8f2-44c8-a8f2-4ba918e6618e"
      }
    }
  }
}
